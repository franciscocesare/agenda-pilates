generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id                    String                 @id @default(cuid())
  nombre                String
  apellido              String
  email                 String                 @unique
  telefono              String                 @unique
  passwordHash          String
  rol                   Role                   @default(CLIENTE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  appointments          Appointment[]
  payments              Payment[]
  recurringReservations RecurringReservation[]
}

model PlanType {
  id              String    @id @default(cuid())
  nombre          String
  tipo            TipoPlan
  clasesPorSemana Int?
  clasesIncluidas Int?
  duracionDias    Int       @default(30)
  precio          Decimal   @db.Decimal(10, 2)
  activo          Boolean   @default(true)
  payments        Payment[]
}

model Payment {
  id                    String                 @id @default(cuid())
  userId                String
  planTypeId            String
  monto                 Decimal                @db.Decimal(10, 2)
  fechaPago             DateTime               @default(now())
  periodoInicio         DateTime               @db.Date
  periodoFin            DateTime               @db.Date
  clasesDisponibles     Int
  estado                EstadoPago             @default(CONFIRMADO)
  createdAt             DateTime               @default(now())
  appointments          Appointment[]
  planType              PlanType               @relation(fields: [planTypeId], references: [id])
  user                  User                   @relation(fields: [userId], references: [id])
  recurringReservations RecurringReservation[]
}

model RecurringReservation {
  id           String        @id @default(cuid())
  userId       String
  paymentId    String
  diaSemana    Int
  hora         String
  activo       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  payment      Payment       @relation(fields: [paymentId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
}

model Appointment {
  id                     String                @id @default(cuid())
  userId                 String
  fecha                  DateTime              @db.Date
  hora                   String
  estado                 EstadoTurno           @default(CONFIRMADO)
  paymentId              String?
  recurringReservationId String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  payment                Payment?              @relation(fields: [paymentId], references: [id])
  recurringReservation   RecurringReservation? @relation(fields: [recurringReservationId], references: [id])
  user                   User                  @relation(fields: [userId], references: [id])

  @@unique([fecha, hora, userId])
  @@index([fecha, hora])
}

model Schedule {
  id         String  @id @default(cuid())
  diaSemana  Int
  horaInicio String
  horaFin    String
  activo     Boolean @default(true)
}

model BlockedDate {
  id     String   @id @default(cuid())
  fecha  DateTime @unique @db.Date
  motivo String
}

model BlockedSlot {
  id        String   @id @default(cuid())
  fecha     DateTime @db.Date
  hora      String
  motivo    String
  createdAt DateTime @default(now())

  @@unique([fecha, hora])
}

model Config {
  id    String @id @default(cuid())
  clave String @unique
  valor String
}

enum Role {
  CLIENTE
  ADMIN
}

enum TipoPlan {
  SUELTA
  MENSUAL
}

enum EstadoPago {
  CONFIRMADO
  PENDIENTE
  CANCELADO
}

enum EstadoTurno {
  PENDIENTE_PAGO
  CONFIRMADO
  CANCELADO
  COMPLETADO
  AUSENTE
}
