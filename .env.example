# Copiar este archivo a .env y completar con valores reales.
# Nunca commitear el archivo .env.

# Cadena de conexión a PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/monte_pilates?schema=public"

# Secreto para firmar las cookies de sesión. Generar uno propio, por ejemplo:
#   openssl rand -base64 32
SESSION_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"
